{
  // 部署前：建 D1 和 R2，把 database_id 填到下面（要用户点头才部署）
  "name": "fengji",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "fengji.sinantrails.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "fengji", "database_id": "31c22576-325b-432d-8f1d-bf460c101bb8" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "fengji-photos" }],
  "vars": { "APPLE_AUDIENCE": "com.avenmeee.fengji" },
  "triggers": { "crons": ["17 9 * * *"] }  // 每天清过期的群里搬来的条目
}
